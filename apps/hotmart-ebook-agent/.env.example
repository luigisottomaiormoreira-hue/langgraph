# ---------------------------------------------------------------------------
# Agente Hotmart — variáveis de ambiente
#
# Copie para `.env` e preencha o que tiver. O que ficar em branco faz o agente
# usar o cliente simulado daquela integração: ele roda completo, com dados
# sintéticos coerentes, sem tocar em nada externo.
#
# NUNCA versione o arquivo `.env` preenchido.
# ---------------------------------------------------------------------------

# --- Produto ---------------------------------------------------------------
PRODUCT_NAME="Meu Ebook"
PRODUCT_PRICE_BRL=97.00
HOTMART_PRODUCT_ID=
PRODUCT_SALES_PAGE_URL=https://exemplo.com/ebook
PRODUCT_CHECKOUT_URL=
SUPPORT_EMAIL=suporte@exemplo.com
SUPPORT_SIGNATURE="Equipe de Suporte"

# --- Operação --------------------------------------------------------------
# L0 observar | L1 recomendar | L2 aprovar (padrão) | L3 autônomo
HOTMART_AGENT_AUTONOMY=L2
# true = nenhuma chamada externa é feita (padrão e recomendado para começar)
HOTMART_AGENT_DRY_RUN=true
HOTMART_AGENT_WINDOW_DAYS=7
HOTMART_AGENT_MODEL=anthropic:claude-sonnet-5
HOTMART_AGENT_HTTP_TIMEOUT=20
HOTMART_AGENT_HTTP_RETRIES=3

# --- Hotmart ---------------------------------------------------------------
# Hotmart > Ferramentas > Credenciais de API
HOTMART_CLIENT_ID=
HOTMART_CLIENT_SECRET=
HOTMART_BASIC_TOKEN=

# --- Meta Ads --------------------------------------------------------------
# Token de sistema com escopo ads_management + ads_read
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=act_000000000000
META_PAGE_ID=
META_PIXEL_ID=

# --- Caixa de suporte ------------------------------------------------------
# Gmail: use uma senha de app, nunca a senha da conta
IMAP_HOST=imap.gmail.com
IMAP_USER=
IMAP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- LLM (opcional) --------------------------------------------------------
# Sem chave, o agente usa apenas o caminho determinístico
ANTHROPIC_API_KEY=
